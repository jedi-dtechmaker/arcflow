VITE_APP_URL=http://localhost:5173

# Privy
# Public App ID only. Never put your Privy App Secret in a Vite frontend app.
VITE_PRIVY_APP_ID=your_privy_app_id

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key, or the older anon public key. Never use service_role or sb_secret here.
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Optional: only use a frontend-safe Circle Client/Kit key. Never use a Circle server API key here.
VITE_CIRCLE_CLIENT_KEY=
